{
  "name": "sable-app",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "error"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "preinstall": "bunx only-allow@1.2.2 bun",
    "test": "bun test",
    "typecheck": "turbo run typecheck",
    "check:spec": "bun .agents/skills/journeys/scripts/journeys.ts check docs/journeys/thin-flow.md && bun scripts/gen-verification.mjs --check",
    "spec:links": "bun scripts/gen-verification.mjs"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "turbo": "^2.11.10"
  }
}
